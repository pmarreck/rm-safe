#!/usr/bin/env luajit

local lfs = require("lfs")
local ffi = require("ffi")

ffi.cdef[[
int isatty(int fd);
unsigned int geteuid(void);
]]

math.randomseed(os.time())

local SCRIPT_VERSION = "5.0-luajit"
local PICKER_DELIM = "__RM_SAFE_PICKER__"

local function stderr_write(msg)
	io.stderr:write(msg)
end

local function exit_with(code)
	os.exit(code)
end

local function shell_quote(s)
	s = tostring(s or "")
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function shell_status(cmd)
	local rc = os.execute(cmd)
	if type(rc) == "number" then
		return math.floor(rc / 256)
	end
	if rc == true then
		return 0
	end
	return 1
end

local function capture_stdout(cmd)
	local p = io.popen(cmd, "r")
	if not p then
		return ""
	end
	local out = p:read("*a") or ""
	p:close()
	return out
end

local function trim(s)
	return (s or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function split_lines(s)
	local t = {}
	for line in (s or ""):gmatch("([^\n]*)\n?") do
		if line == "" and #t > 0 and t[#t] == "" then
			break
		end
		t[#t + 1] = line
	end
	if #t > 0 and t[#t] == "" then
		t[#t] = nil
	end
	return t
end

local function read_file(path)
	local f = io.open(path, "rb")
	if not f then
		return nil
	end
	local data = f:read("*a")
	f:close()
	return data
end

local function write_file(path, data)
	local f, err = io.open(path, "wb")
	if not f then
		return nil, err
	end
	f:write(data)
	f:close()
	return true
end

local function file_exists(path)
	return lfs.attributes(path) ~= nil
end

local function path_exists(path)
	return lfs.symlinkattributes(path) ~= nil
end

local function is_symlink(path)
	local a = lfs.symlinkattributes(path)
	return a and a.mode == "link"
end

local function is_directory_nonlink(path)
	local a = lfs.symlinkattributes(path)
	return a and a.mode == "directory"
end

local function basename(path)
	if not path or path == "" then
		return ""
	end
	if path == "/" then
		return "/"
	end
	path = path:gsub("/+$", "")
	local b = path:match("([^/]+)$")
	return b or path
end

local function dirname(path)
	if not path or path == "" then
		return "."
	end
	if path == "/" then
		return "/"
	end
	path = path:gsub("/+$", "")
	local d = path:match("^(.*)/[^/]*$")
	if not d or d == "" then
		return "."
	end
	return d
end

local function path_join(a, b)
	if a:sub(-1) == "/" then
		return a .. b
	end
	return a .. "/" .. b
end

local function mkdir_p(path)
	if path == "" or path == "." then
		return true
	end
	if path == "/" then
		return true
	end
	local mode = lfs.attributes(path, "mode")
	if mode == "directory" then
		return true
	end
	if mode ~= nil and mode ~= "directory" then
		return nil, "not a directory"
	end
	local parent = dirname(path)
	if parent ~= path then
		local ok, err = mkdir_p(parent)
		if not ok then
			return nil, err
		end
	end
	local ok, err = lfs.mkdir(path)
	if ok then
		return true
	end
	if lfs.attributes(path, "mode") == "directory" then
		return true
	end
	return nil, err
end

local function touch_file(path)
	local f = io.open(path, "ab")
	if not f then
		return false
	end
	f:close()
	return true
end

local function normalize_absolute(path)
	local is_abs = path:sub(1, 1) == "/"
	local parts = {}
	for token in path:gmatch("[^/]+") do
		if token == "." or token == "" then
			-- skip
		elseif token == ".." then
			if #parts > 0 then
				table.remove(parts)
			end
		else
			parts[#parts + 1] = token
		end
	end
	local out = table.concat(parts, "/")
	if is_abs then
		out = "/" .. out
	end
	if out == "" then
		return is_abs and "/" or "."
	end
	return out
end

local function resolve_path(path)
	if path == "" then
		return lfs.currentdir()
	end
	local abs
	if path:sub(1, 1) == "/" then
		abs = path
	else
		abs = path_join(lfs.currentdir(), path)
	end
	return normalize_absolute(abs)
end

local OS = trim(capture_stdout("uname -s"))
if OS == "" then
	OS = jit.os == "OSX" and "Darwin" or "Linux"
end

local USER_ID = tonumber(ffi.C.geteuid()) or 0
local USER_NAME = os.getenv("USER") or trim(capture_stdout("id -un"))
if USER_NAME == "" then
	USER_NAME = "unknown"
end

local function command_exists(cmd)
	return shell_status("command -v " .. shell_quote(cmd) .. " >/dev/null 2>&1") == 0
end

local HAS_TAC = false
local HAS_GUM = false
local HAS_FZF = false
local HAS_GIO = false
local HAS_TRASHPUT = false
local HAS_LSATTR = false

local function detect_capabilities()
	HAS_TAC = command_exists("tac")
	HAS_GUM = command_exists("gum")
	HAS_FZF = command_exists("fzf")
	HAS_GIO = command_exists("gio")
	HAS_TRASHPUT = command_exists("trash-put")
	HAS_LSATTR = command_exists("lsattr")
end

local function timestamp_utc(fmt)
	return os.date("!" .. fmt)
end

local function get_trash_base()
	if USER_ID == 0 then
		if OS == "Darwin" then
			return "/var/root/.Trash"
		elseif OS == "Linux" then
			return "/root/.local/share/Trash"
		end
	else
		local home = os.getenv("HOME") or ""
		if OS == "Darwin" then
			return home .. "/.Trash"
		elseif OS == "Linux" then
			local xdg = os.getenv("XDG_DATA_HOME")
			if xdg and xdg ~= "" then
				return xdg .. "/Trash"
			end
			return home .. "/.local/share/Trash"
		end
	end
	return nil
end

local TRASH_BASE_DIR = ""
local TRASH_FILES_DIR = ""
local TRASH_INFO_DIR = ""
local LOG_FILE = ""

local opts = {
	force = false,
	interactive = false,
	recursive = false,
	verbose = false,
}

local PREFIX_PROTECTED = {
	"/root", "/etc", "/var", "/usr", "/bin", "/sbin", "/lib", "/opt", "/nix/store",
	"/System", "/Library",
}

local EXACT_PROTECTED = {
	"/", "/*", "/home/*", "/Users/*", "/var/tmp",
	"/bin/*", "/usr/bin", "/usr/bin/*",
	"/lib/*", "/usr/lib", "/usr/lib/*",
	"/var/*", "/usr/var", "/usr/var/*",
	"/etc/*", "/usr/etc", "/usr/etc/*",
	"/opt/*", "/usr/opt", "/usr/opt/*",
	"/nix/*", "/usr/nix", "/usr/nix/*",
	"/proc/*", "/sys/*", "/dev/*",
	"/run/*", "/mnt/*", "/media/*",
}

local function verbose(msg)
	if opts.verbose then
		stderr_write("rm-safe: " .. msg .. "\n")
	end
end

local function init()
	TRASH_BASE_DIR = get_trash_base()
	if not TRASH_BASE_DIR then
		stderr_write("rm-safe: Error: Unsupported OS\n")
		exit_with(1)
	end
	TRASH_FILES_DIR = path_join(TRASH_BASE_DIR, "files")
	TRASH_INFO_DIR = path_join(TRASH_BASE_DIR, "info")
	LOG_FILE = path_join(TRASH_BASE_DIR, "rm_safe.log")

	local ok = mkdir_p(TRASH_FILES_DIR)
	if not ok then
		stderr_write("rm-safe: Error: Cannot create trash directories\n")
		exit_with(1)
	end
	ok = mkdir_p(TRASH_INFO_DIR)
	if not ok then
		stderr_write("rm-safe: Error: Cannot create trash directories\n")
		exit_with(1)
	end

	if not touch_file(LOG_FILE) then
		stderr_write("rm-safe: Warning: Cannot create log file: " .. LOG_FILE .. "\n")
		LOG_FILE = ""
	end

	detect_capabilities()
end

local function log_action(action, path, trash_path, details)
	if LOG_FILE == "" then
		return
	end
	trash_path = trash_path or "N/A"
	details = details or ""
	if os.getenv("TEST_MODE") == "true" then
		action = "TEST_" .. action
	end
	local line = table.concat({
		timestamp_utc("%Y-%m-%dT%H:%M:%SZ"),
		USER_NAME,
		action,
		path,
		trash_path,
		details,
	}, "\t") .. "\n"
	local f = io.open(LOG_FILE, "ab")
	if f then
		f:write(line)
		f:close()
	end
end

local function is_interactive_terminal()
	return ffi.C.isatty(0) == 1 and ffi.C.isatty(1) == 1
end

local function parse_log_line(line)
	local fields = {}
	local start = 1
	for i = 1, 5 do
		local j = line:find("\t", start, true)
		if not j then
			break
		end
		fields[i] = line:sub(start, j - 1)
		start = j + 1
	end
	fields[6] = line:sub(start)
	for i = 1, 6 do
		if fields[i] == nil then
			fields[i] = ""
		end
	end
	return fields
end

local function reverse_log_lines(path)
	local data = read_file(path)
	if not data then
		return nil
	end
	local lines = split_lines(data)
	local rev = {}
	for i = #lines, 1, -1 do
		rev[#rev + 1] = lines[i]
	end
	return rev
end

local function manual_trash_action()
	if os.getenv("TEST_MODE") == "true" then
		return "TEST_TRASH_MANUAL"
	end
	return "TRASH_MANUAL"
end

local function parse_undo_offset(arg)
	if not arg or arg == "" then
		return 1
	end
	if arg:match("^%-%d+$") then
		local offset = tonumber(arg:sub(2))
		if offset and offset >= 1 then
			return offset
		end
	end
	stderr_write("rm-safe: Invalid undo offset: " .. tostring(arg) .. "\n")
	return nil
end

local function get_trash_manual_entry(offset, action_name)
	if LOG_FILE == "" then
		return nil
	end
	local lines = reverse_log_lines(LOG_FILE)
	if not lines then
		return nil
	end
	local count = 0
	for _, line in ipairs(lines) do
		local f = parse_log_line(line)
		if f[3] == action_name then
			count = count + 1
			if count == offset then
				return line
			end
		end
	end
	return nil
end

local function move_path(src, dst)
	local ok = os.rename(src, dst)
	if ok then
		return true
	end
	local cmd = "mv -- " .. shell_quote(src) .. " " .. shell_quote(dst) .. " >/dev/null 2>&1"
	return shell_status(cmd) == 0
end

local function restore_trash_entry(trash_path, original_path)
	if not trash_path or trash_path == "" or not original_path or original_path == "" then
		stderr_write("rm-safe: Error: Restore paths are empty\n")
		return false
	end
	if not path_exists(trash_path) then
		stderr_write("rm-safe: Error: Trash path not found: " .. trash_path .. "\n")
		return false
	end
	if path_exists(original_path) then
		stderr_write("rm-safe: Error: Restore target already exists: " .. original_path .. "\n")
		return false
	end

	local original_dir = dirname(original_path)
	if not mkdir_p(original_dir) then
		stderr_write("rm-safe: Error: Cannot create directory: " .. original_dir .. "\n")
		return false
	end

	if move_path(trash_path, original_path) then
		local info_file = path_join(TRASH_INFO_DIR, basename(trash_path) .. ".trashinfo")
		os.remove(info_file)
		log_action("TRASH_RESTORE", trash_path, original_path)
		stderr_write("Path " .. trash_path .. " restored to " .. original_path .. " successfully.\n")
		return true
	end

	stderr_write("rm-safe: Error: Failed to restore '" .. trash_path .. "' to '" .. original_path .. "'\n")
	return false
end

local function undo_with_offset(offset)
	offset = offset or 1
	if LOG_FILE == "" or not file_exists(LOG_FILE) then
		stderr_write("rm-safe: Error: Log file not available for undo\n")
		return false
	end
	local action_name = manual_trash_action()
	local line = get_trash_manual_entry(offset, action_name)
	if not line then
		stderr_write("rm-safe: Error: No " .. action_name .. " entry found to undo\n")
		return false
	end
	local f = parse_log_line(line)
	return restore_trash_entry(f[5], f[4])
end

local function strip_ansi(s)
	return (s or ""):gsub("\27%[[0-9;]*[%a]", "")
end

local function run_picker(picker, menu_lines)
	local tmpdir = os.getenv("TMPDIR") or "/tmp"
	local base = string.format("%s/rm-safe-picker.%d.%d", tmpdir, os.time(), math.random(1000000))
	local in_file = base .. ".in"
	local out_file = base .. ".out"
	write_file(in_file, table.concat(menu_lines, "\n") .. "\n")

	local cmd
	if picker == "gum" then
		cmd = "cat " .. shell_quote(in_file) .. " | gum choose --label-delimiter " .. shell_quote(PICKER_DELIM) .. " --select-if-one > " .. shell_quote(out_file)
	else
		cmd = "cat " .. shell_quote(in_file) .. " | fzf --delimiter " .. shell_quote(PICKER_DELIM) .. " --with-nth 1 --select-1 > " .. shell_quote(out_file)
	end

	local rc = shell_status(cmd)
	local out = read_file(out_file) or ""
	os.remove(in_file)
	os.remove(out_file)
	if rc ~= 0 then
		return nil
	end
	out = out:gsub("\r", ""):gsub("\n+$", "")
	if out == "" then
		return nil
	end
	return out
end

local function undo_picker(offset_arg)
	if offset_arg then
		return undo_with_offset(offset_arg)
	end

	if not is_interactive_terminal() then
		stderr_write("rm-safe: Warning: --undo-picker requires an interactive terminal; falling back to --undo\n")
		return undo_with_offset(1)
	end

	local picker = "gum"
	if not HAS_GUM then
		stderr_write("rm-safe: Warning: gum not found; trying fzf\n")
		if HAS_FZF then
			picker = "fzf"
		else
			stderr_write("rm-safe: Warning: fzf not found; cannot use --undo-picker\n")
			return false
		end
	end

	if LOG_FILE == "" or not file_exists(LOG_FILE) then
		stderr_write("rm-safe: Error: Log file not available for undo\n")
		return false
	end

	local action_name = manual_trash_action()
	local lines = reverse_log_lines(LOG_FILE)
	if not lines then
		stderr_write("rm-safe: Error: Log file not available for undo\n")
		return false
	end

	local manual_lines = {}
	for _, line in ipairs(lines) do
		local f = parse_log_line(line)
		if f[3] == action_name then
			manual_lines[#manual_lines + 1] = line
		end
	end
	if #manual_lines == 0 then
		stderr_write("rm-safe: Error: No " .. action_name .. " entries found to undo\n")
		return false
	end

	local menu = {}
	for i, line in ipairs(manual_lines) do
		local f = parse_log_line(line)
		menu[#menu + 1] = string.format("[%d] %s  %s -> %s%s%d", i, f[1], f[4], f[5], PICKER_DELIM, i)
	end

	local selection = run_picker(picker, menu)
	if not selection then
		stderr_write("rm-safe: Undo canceled\n")
		return false
	end

	local index_str
	if picker == "fzf" then
		selection = strip_ansi(selection)
		index_str = selection:match(PICKER_DELIM .. "(%d+)%s*$")
	else
		index_str = trim(selection)
	end

	local idx = tonumber(index_str)
	if not idx or idx < 1 or idx > #manual_lines then
		stderr_write("rm-safe: Error: Unable to parse selection\n")
		return false
	end

	local selected = parse_log_line(manual_lines[idx])
	return restore_trash_entry(selected[5], selected[4])
end

local function is_protected(path)
	for _, pattern in ipairs(EXACT_PROTECTED) do
		if pattern:sub(-2) == "/*" and pattern ~= "/*" then
			local base = pattern:sub(1, -3)
			if base == "" then
				base = "/"
			end
			if path:sub(1, #base + 1) == base .. "/" then
				local rel = path:sub(#base + 2)
				if rel ~= "" and not rel:find("/", 1, true) then
					return true
				end
			end
		elseif path == pattern then
			return true
		end
	end

	for _, prefix in ipairs(PREFIX_PROTECTED) do
		if path == prefix or path:sub(1, #prefix + 1) == prefix .. "/" then
			return true
		end
	end

	if path == TRASH_BASE_DIR or path == TRASH_FILES_DIR or path == TRASH_INFO_DIR or (LOG_FILE ~= "" and path == LOG_FILE) then
		return true
	end

	return false
end

local function is_immutable(path)
	if not path_exists(path) then
		return false
	end

	if HAS_LSATTR then
		local out = trim(capture_stdout("lsattr -d -- " .. shell_quote(path) .. " 2>/dev/null"))
		local first = out:match("^(%S+)") or ""
		if first:sub(5, 5) == "i" then
			return true
		end
	end

	if OS == "Darwin" then
		local out = trim(capture_stdout("ls -ldO -- " .. shell_quote(path) .. " 2>/dev/null"))
		local flags = out:match("^%S+%s+%S+%s+%S+%s+%S+%s+(%S+)") or ""
		if flags:find("schg", 1, true) then
			return true
		end
		if flags:find("uchg", 1, true) and USER_ID ~= 0 then
			return true
		end
	end

	return false
end

local function url_encode_path(path)
	local out = {}
	for i = 1, #path do
		local b = path:byte(i)
		local keep =
			(b >= 48 and b <= 57) or
			(b >= 65 and b <= 90) or
			(b >= 97 and b <= 122) or
			b == 46 or b == 95 or b == 126 or b == 45 or b == 47
		if keep then
			out[#out + 1] = string.char(b)
		else
			out[#out + 1] = string.format("%%%02X", b)
		end
	end
	return table.concat(out)
end

local function create_trashinfo(original_path, trash_name)
	local info_file = path_join(TRASH_INFO_DIR, trash_name .. ".trashinfo")
	local encoded_path = url_encode_path(original_path)
	local deletion_date = timestamp_utc("%Y-%m-%dT%H:%M:%S")
	local body = string.format("[Trash Info]\nPath=%s\nDeletionDate=%s\n", encoded_path, deletion_date)
	local ok = write_file(info_file, body)
	return ok ~= nil
end

local function get_unique_name(base_name)
	local name = base_name
	local counter = 1
	while path_exists(path_join(TRASH_FILES_DIR, name)) or path_exists(path_join(TRASH_INFO_DIR, name .. ".trashinfo")) do
		name = string.format("%s_%s_%d", base_name, timestamp_utc("%Y%m%d%H%M%S"), counter)
		counter = counter + 1
	end
	return name
end

local function prompt_yes_no(prompt)
	local tty_out = io.open("/dev/tty", "w")
	local tty_in = io.open("/dev/tty", "r")
	if not tty_out or not tty_in then
		if tty_out then tty_out:close() end
		if tty_in then tty_in:close() end
		return false
	end
	tty_out:write(prompt)
	tty_out:flush()
	local ch = tty_in:read(1) or ""
	tty_out:write("\n")
	tty_out:flush()
	tty_in:close()
	tty_out:close()
	return ch:match("^[Yy]$") ~= nil
end

local function trash_item(item)
	local abs_path = resolve_path(item)
	verbose("Processing: " .. item .. " -> " .. abs_path)

	if not opts.force and is_immutable(abs_path) then
		stderr_write("rm-safe: Error: Cannot remove '" .. item .. "': Item is immutable\n")
		log_action("FAIL_IMMUTABLE", abs_path)
		return false
	end

	if is_protected(abs_path) then
		if not opts.force then
			stderr_write("rm-safe: WARNING: '" .. item .. "' is protected\n")
			if not prompt_yes_no("rm-safe: Move to trash anyway? (y/n): ") then
				log_action("SKIP_PROTECTED", abs_path)
				return true
			end
			log_action("CONFIRM_PROTECTED", abs_path)
		else
			verbose("Forcing removal of protected item: " .. item)
			log_action("FORCE_PROTECTED", abs_path)
		end
	end

	if opts.interactive and not opts.force then
		if not prompt_yes_no("rm-safe: Remove '" .. item .. "'? (y/n): ") then
			log_action("SKIP_INTERACTIVE", abs_path)
			return true
		end
	end

	if OS == "Linux" then
		if HAS_GIO and shell_status("gio trash -- " .. shell_quote(item) .. " 2>/dev/null") == 0 then
			log_action("TRASH_GIO", abs_path)
			return true
		end
		if HAS_TRASHPUT and shell_status("trash-put -- " .. shell_quote(item) .. " 2>/dev/null") == 0 then
			log_action("TRASH_TRASHPUT", abs_path)
			return true
		end
	end

	local base_name = basename(abs_path)
	local trash_name = get_unique_name(base_name)
	local trash_path = path_join(TRASH_FILES_DIR, trash_name)

	if move_path(abs_path, trash_path) then
		create_trashinfo(abs_path, trash_name)
		log_action("TRASH_MANUAL", abs_path, trash_path)
		verbose("Moved '" .. item .. "' to trash as '" .. trash_name .. "'")
		return true
	end

	stderr_write("rm-safe: Error: Failed to move '" .. item .. "' to trash\n")
	log_action("FAIL_MOVE", abs_path)
	return false
end

local function show_help()
	local base_dir = TRASH_BASE_DIR ~= "" and TRASH_BASE_DIR or (get_trash_base() or "")
	local file_dir = TRASH_FILES_DIR ~= "" and TRASH_FILES_DIR or path_join(base_dir, "files")
	local info_dir = TRASH_INFO_DIR ~= "" and TRASH_INFO_DIR or path_join(base_dir, "info")
	local log_path = LOG_FILE ~= "" and LOG_FILE or path_join(base_dir, "rm_safe.log")
	io.write(string.format([[rm-safe %s - Move files to trash instead of deleting

Usage:
  rm-safe [OPTIONS] FILE...
  rm-safe --undo [-N]
  rm-safe --undo-picker [-N]

Options:
  -f, --force        Override protection prompts
  -i, --interactive  Prompt before every removal
  -r, --recursive    Remove directories recursively (atomic operation)
  -v, --verbose      Explain what is being done
  -a, --about        Show a one-line description of this tool
  -h, --help         Show this help
  --test             Run integrated test suite
  --undo             Restore the most recent TRASH_MANUAL entry
  --undo-picker      Pick a TRASH_MANUAL entry to restore (uses gum or fzf)

Undo offsets:
  Pass a negative number like -2 to restore the 2nd most recent
  TRASH_MANUAL entry (so -1 is the default).

Trash location: %s
  Files: %s
  Info:  %s
  Log:   %s
]], SCRIPT_VERSION, base_dir, file_dir, info_dir, log_path))
end

local function run_tests()
	print("=== rm-safe Test Suite ===")
	local script_path = resolve_path(arg[0] or "bin/rm-safe")
	local repo_root = dirname(dirname(script_path))
	local fail = 0

	local rc1 = shell_status(shell_quote(path_join(path_join(repo_root, "bin/test"), "rm-safe_test")))
	if rc1 ~= 0 then
		fail = fail + 1
	end

	local rc2 = shell_status(shell_quote(path_join(path_join(repo_root, "bin/test"), "rm_override_test")))
	if rc2 ~= 0 then
		fail = fail + 1
	end

	print("=== Integrated Summary ===")
	print("Failed suites: " .. tostring(fail))
	return fail == 0
end

local args = {}
for i = 1, #arg do
	args[#args + 1] = arg[i]
end

local undo_mode = nil
local undo_offset_arg = nil
local operands = {}

local i = 1
while i <= #args do
	local a = args[i]
	if a == "--" then
		for j = i + 1, #args do
			operands[#operands + 1] = args[j]
		end
		break
	elseif a == "-f" or a == "--force" then
		opts.force = true
	elseif a == "-i" or a == "--interactive" then
		opts.interactive = true
	elseif a == "-r" or a == "-R" or a == "--recursive" then
		opts.recursive = true
	elseif a == "-v" or a == "--verbose" then
		opts.verbose = true
	elseif a == "-a" or a == "--about" then
		print("rm-safe: A safer 'rm' that moves files to the system trash instead of permanently deleting them.")
		exit_with(0)
	elseif a == "-h" or a == "--help" then
		show_help()
		exit_with(0)
	elseif a == "--test" then
		init()
		if run_tests() then
			exit_with(0)
		end
		exit_with(1)
	elseif a == "--undo" or a:match("^%-%-undo=") then
		if undo_mode then
			stderr_write("rm-safe: Error: --undo and --undo-picker are mutually exclusive\n")
			exit_with(1)
		end
		undo_mode = "undo"
		if a:match("^%-%-undo=") then
			undo_offset_arg = a:sub(#"--undo=" + 1)
		elseif i + 1 <= #args and args[i + 1]:match("^%-%d+$") then
			undo_offset_arg = args[i + 1]
			i = i + 1
		end
	elseif a == "--undo-picker" or a:match("^%-%-undo%-picker=") then
		if undo_mode then
			stderr_write("rm-safe: Error: --undo and --undo-picker are mutually exclusive\n")
			exit_with(1)
		end
		undo_mode = "undo-picker"
		if a:match("^%-%-undo%-picker=") then
			undo_offset_arg = a:sub(#"--undo-picker=" + 1)
		elseif i + 1 <= #args and args[i + 1]:match("^%-%d+$") then
			undo_offset_arg = args[i + 1]
			i = i + 1
		end
	elseif a:sub(1, 1) == "-" and a ~= "-" then
		local flags = a:sub(2)
		for k = 1, #flags do
			local f = flags:sub(k, k)
			if f == "f" then
				opts.force = true
			elseif f == "i" then
				opts.interactive = true
			elseif f == "r" or f == "R" then
				opts.recursive = true
			elseif f == "v" then
				opts.verbose = true
			elseif f == "a" then
				print("rm-safe: A safer 'rm' that moves files to the system trash instead of permanently deleting them.")
				exit_with(0)
			elseif f == "h" then
				show_help()
				exit_with(0)
			else
				stderr_write("rm-safe: Invalid option: -" .. f .. "\n")
				exit_with(1)
			end
		end
	else
		for j = i, #args do
			operands[#operands + 1] = args[j]
		end
		break
	end
	i = i + 1
end

if undo_mode then
	if #operands > 0 then
		stderr_write("rm-safe: Error: undo options do not accept file operands\n")
		exit_with(1)
	end

	init()
	local offset = nil
	if undo_offset_arg and undo_offset_arg ~= "" then
		offset = parse_undo_offset(undo_offset_arg)
		if not offset then
			exit_with(1)
		end
		if undo_mode == "undo-picker" and offset == 1 then
			offset = nil
		end
	end

	local ok
	if undo_mode == "undo" then
		ok = undo_with_offset(offset or 1)
	else
		ok = undo_picker(offset)
	end
	exit_with(ok and 0 or 1)
end

if #operands == 0 then
	stderr_write("rm-safe: missing operand\n")
	stderr_write("Try 'rm-safe --help' for more information.\n")
	exit_with(1)
end

init()

local exit_code = 0
for _, item in ipairs(operands) do
	if item ~= "" then
		if not path_exists(item) then
			if not opts.force then
				stderr_write("rm-safe: '" .. item .. "': No such file or directory\n")
				log_action("FAIL_NOEXIST", item)
				exit_code = 1
			end
		elseif is_directory_nonlink(item) and not opts.recursive then
			stderr_write("rm-safe: '" .. item .. "': Is a directory (use -r)\n")
			log_action("FAIL_ISDIR", resolve_path(item))
			exit_code = 1
		else
			if is_directory_nonlink(item) and opts.recursive then
				verbose("Atomically moving directory to trash: " .. item)
			end
			if not trash_item(item) then
				exit_code = 1
			end
		end
	end
end

exit_with(exit_code)

#!/usr/bin/env bash

fails=0
tests=0
skips=0

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
. "$REPO_ROOT/bin/test/capture.bash"

# Portable temp-dir creation (GNU --tmpdir is unavailable on BSD mktemp).
_mk_tmpdir() { # $1 = name prefix
	mktemp -d "${TMPDIR:-/tmp}/$1.XXXXXX"
}

TEST_DIR=$(_mk_tmpdir rm-safe-test)
REAL_RM=$([ -x /bin/rm ] && echo /bin/rm || command -v rm || echo rm)
trap '"$REAL_RM" -rf "$TEST_DIR"' EXIT

HOME_DIR="$TEST_DIR/home"
XDG_DIR="$TEST_DIR/xdg"
WORK_DIR="$TEST_DIR/work"
BIN_DIR="$TEST_DIR/bin"
BASH_DIR="$(dirname "$(command -v bash)")"
HOST_PATH="$PATH"
PATH_BASE="$BIN_DIR:$BASH_DIR:$REPO_ROOT/bin:$HOST_PATH"

mkdir -p "$HOME_DIR" "$XDG_DIR" "$WORK_DIR" "$BIN_DIR"

# Select the implementation under test. RM_SAFE_BIN (absolute path) wins;
# default is the luajit impl. We expose it as $BIN_DIR/rm-safe, and $BIN_DIR
# is first on PATH_BASE, so every `rm-safe` invocation hits the selected impl.
RM_SAFE_BIN=${RM_SAFE_BIN:-"$REPO_ROOT/bin/rm-safe"}
if [[ ! -x $RM_SAFE_BIN ]]; then
	echo "rm-safe_test: RM_SAFE_BIN=$RM_SAFE_BIN is not executable" >&2
	exit 2
fi
ln -sf -- "$RM_SAFE_BIN" "$BIN_DIR/rm-safe"

cat >"$BIN_DIR/gio" <<'GIO'
#!/bin/sh
exit 1
GIO
chmod +x "$BIN_DIR/gio"

cat >"$BIN_DIR/trash-put" <<'TRASHPUT'
#!/bin/sh
exit 1
TRASHPUT
chmod +x "$BIN_DIR/trash-put"

if [[ $(uname) == "Darwin" ]]; then
	TRASH_BASE="$HOME_DIR/.Trash"
else
	TRASH_BASE="$XDG_DIR/Trash"
fi

TRASH_FILES="$TRASH_BASE/files"
TRASH_INFO="$TRASH_BASE/info"
LOG_DIR="$TRASH_BASE/rm-safe-log"

reset_trash() {
	mkdir -p "$TRASH_FILES" "$TRASH_INFO" "$LOG_DIR"
	find "$TRASH_FILES" -mindepth 1 -maxdepth 1 -exec "$REAL_RM" -rf {} + 2>/dev/null || true
	find "$TRASH_INFO" -mindepth 1 -maxdepth 1 -exec "$REAL_RM" -rf {} + 2>/dev/null || true
	find "$LOG_DIR" -mindepth 1 -maxdepth 1 -exec "$REAL_RM" -rf {} + 2>/dev/null || true
}

# Concatenate all log fragments in temporal order (filenames start with
# an epoch-ns timestamp, so lex sort == time sort). Reproduces what the
# old single-file log used to give us in one `cat`.
read_all_logs() {
	if [[ -d "$LOG_DIR" ]]; then
		find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type f | sort | xargs cat 2>/dev/null
	fi
}

skip_test() {
	local name=$1
	local reason=$2
	echo "SKIP $name: $reason" >&2
	((skips++))
}

path_without_commands() {
	local input_path=$1
	shift
	local filtered=""
	local part cmd skip_part
	IFS=: read -r -a parts <<<"$input_path"
	for part in "${parts[@]}"; do
		[[ -z $part ]] && continue
		skip_part=false
		for cmd in "$@"; do
			if [[ -x $part/$cmd ]]; then
				skip_part=true
				break
			fi
		done
		[[ $skip_part == true ]] && continue
		if [[ -z $filtered ]]; then
			filtered=$part
		else
			filtered="$filtered:$part"
		fi
	done
	echo "$filtered"
}

build_path_with_fzf_only() {
	local fzf_source=$1
	local overlay_dir="$TEST_DIR/path-overlay"
	local cmd cmd_path
	mkdir -p "$overlay_dir"

	# Use symlinks only; never copy binaries into the overlay PATH.
	ln -sf -- "$fzf_source" "$overlay_dir/fzf"
	for cmd in bash luajit expect; do
		cmd_path=$(PATH="$PATH_BASE" command -v "$cmd" || true)
		[[ -n $cmd_path ]] && ln -sf -- "$cmd_path" "$overlay_dir/$cmd"
	done
	# Ensure core POSIX tools resolve to real system binaries, not any ~/bin wrapper
	# scripts that shadow them (e.g. ~/bin/date, ~/bin/tac).  Search known safe
	# locations in priority order; skip if none found.
	for cmd in date awk sed; do
		for sys_dir in /bin /usr/bin; do
			if [[ -x "$sys_dir/$cmd" ]]; then
				ln -sf -- "$sys_dir/$cmd" "$overlay_dir/$cmd"
				break
			fi
		done
	done
	if [[ ! -L $overlay_dir/fzf ]]; then
		return 1
	fi

	local host_filtered
	host_filtered=$(path_without_commands "$HOST_PATH" gum fzf)
	echo "$overlay_dir:$BIN_DIR:$REPO_ROOT/bin:$host_filtered"
}

run_cmd() {
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$PATH_BASE" rm-safe "$@"
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

# Like run_cmd but with an explicit PATH, for exercising degraded environments.
run_cmd_with_path() {
	local path_override=$1; shift
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$path_override" rm-safe "$@"
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

run_cmd_no_tty() {
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$PATH_BASE" bash -c 'rm-safe "$@"' _ "$@" </dev/null
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

run_cmd_expect() {
	local path_override=$1
	local cmd_args=$2
	local out err rc
	capture env HOME="$HOME_DIR" XDG_DATA_HOME="$XDG_DIR" PATH="$path_override" expect -c "
		set timeout 5
		spawn -noecho rm-safe $cmd_args
		after 200
		send \"\\r\"
		set rc 1
		expect {
			eof { catch {lassign [wait] _p _s _e rc} }
			timeout { catch {exec kill -9 [exp_pid]}; catch {wait}; set rc 124 }
		}
		exit \$rc
	"
	RM_OUT="$out"
	RM_ERR="$err"
	RM_RC="$rc"
}

# Test 0: the selected impl is the one being exercised
((tests++))
if [[ "$(readlink "$BIN_DIR/rm-safe")" == "$RM_SAFE_BIN" ]]; then
	echo "OK exercising impl: $RM_SAFE_BIN"
else
	echo "FAIL impl selection wrong" >&2
	((fails++))
fi

# Test 1: --undo restores last TRASH_MANUAL and logs TRASH_RESTORE
reset_trash
((tests++))
echo "hello" >"$WORK_DIR/file1"
run_cmd "$WORK_DIR/file1"
if [[ $RM_RC -ne 0 ]]; then
	echo "FAIL rm-safe failed to trash file" >&2
	printf '%s\n' "$RM_ERR" >&2
	((fails++))
else
	line=$(read_all_logs | awk -F'\t' '$3=="TRASH_MANUAL"{line=$0} END{print line}')
	if [[ -z $line ]]; then
		echo "FAIL TRASH_MANUAL log entry missing" >&2
		((fails++))
	else
		IFS=$'\t' read -r ts user action original trash_path details <<<"$line"
		run_cmd --undo
		if [[ $RM_RC -eq 0 && -e $original && ! -e $trash_path ]] && printf '%s' "$RM_ERR" | grep -F "Path $trash_path restored to $original successfully." >/dev/null; then
			restore_line=$(read_all_logs | tail -n 1)
			IFS=$'\t' read -r rts ruser raction rsrc rdest rdetails <<<"$restore_line"
			if [[ $raction == "TRASH_RESTORE" && $rsrc == "$trash_path" && $rdest == "$original" ]]; then
				echo "OK --undo restores last TRASH_MANUAL"
			else
				echo "FAIL TRASH_RESTORE log entry incorrect" >&2
				((fails++))
			fi
		else
			echo "FAIL --undo did not restore file or message missing" >&2
			printf '%s\n' "$RM_ERR" >&2
			((fails++))
		fi
	fi
fi

# Test 2: --undo -2 restores the second-to-last TRASH_MANUAL
reset_trash
((tests++))
echo "a" >"$WORK_DIR/fileA"
echo "b" >"$WORK_DIR/fileB"
run_cmd "$WORK_DIR/fileA"
run_cmd "$WORK_DIR/fileB"
run_cmd --undo -2
if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileA" && ! -e "$WORK_DIR/fileB" ]]; then
	echo "OK --undo -2 restores second-to-last entry"
else
	echo "FAIL --undo -2 did not restore expected file" >&2
	printf '%s\n' "$RM_ERR" >&2
	((fails++))
fi

# Test 3: --undo-picker falls back to --undo in non-interactive mode (with warning)
reset_trash
((tests++))
echo "c" >"$WORK_DIR/fileC"
run_cmd "$WORK_DIR/fileC"
run_cmd_no_tty --undo-picker
if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileC" ]] && printf '%s' "$RM_ERR" | grep -F "falling back to --undo" >/dev/null; then
	echo "OK --undo-picker falls back to --undo when non-interactive"
else
	echo "FAIL --undo-picker fallback failed" >&2
	printf '%s\n' "$RM_ERR" >&2
	((fails++))
fi

# Test 4: --undo-picker uses gum in interactive mode
reset_trash
((tests++))
if ! PATH="$PATH_BASE" command -v gum >/dev/null 2>&1; then
	skip_test "--undo-picker gum" "gum not installed"
else
	echo "d" >"$WORK_DIR/fileD"
	run_cmd "$WORK_DIR/fileD"
	run_cmd_expect "$PATH_BASE" "--undo-picker"
	if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileD" ]]; then
		echo "OK --undo-picker restores via gum"
	else
		echo "FAIL --undo-picker gum restore failed" >&2
		printf '%s\n' "$RM_OUT" >&2
		printf '%s\n' "$RM_ERR" >&2
		((fails++))
	fi
fi

# Test 5: --undo-picker falls back to fzf when gum is missing
reset_trash
((tests++))
fzf_path=$(PATH="$PATH_BASE" command -v fzf || true)
if [[ -z $fzf_path ]]; then
	skip_test "--undo-picker fzf" "fzf not installed"
else
	if ! PATH_FZF=$(build_path_with_fzf_only "$fzf_path"); then
		echo "FAIL --undo-picker fzf setup failed: overlay path build failed" >&2
		((fails++))
	elif [[ ! -L "$TEST_DIR/path-overlay/fzf" ]]; then
		echo "FAIL --undo-picker fzf setup failed: fzf overlay entry is not a symlink" >&2
		((fails++))
	elif PATH="$PATH_FZF" command -v gum >/dev/null 2>&1; then
		echo "FAIL --undo-picker fzf setup failed: gum still visible in PATH" >&2
		((fails++))
	elif ! PATH="$PATH_FZF" command -v fzf >/dev/null 2>&1; then
		echo "FAIL --undo-picker fzf setup failed: fzf missing from PATH overlay" >&2
		((fails++))
	else
		echo "e" >"$WORK_DIR/fileE"
		run_cmd "$WORK_DIR/fileE"
		run_cmd_expect "$PATH_FZF" "--undo-picker"
		if [[ $RM_RC -eq 0 && -e "$WORK_DIR/fileE" ]] && printf '%s\n%s' "$RM_ERR" "$RM_OUT" | grep -F "gum not found; trying fzf" >/dev/null; then
			echo "OK --undo-picker restores via fzf"
		else
			echo "FAIL --undo-picker fzf restore failed" >&2
			printf '%s\n' "$RM_ERR" >&2
			((fails++))
		fi
	fi
fi

# Test: bash 3.2 emits a suppressible degraded-setup warning
((tests++))
B32=""
for c in /bin/bash; do v=$("$c" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null); [[ $v == 3 ]] && B32=$c; done
if [[ -z $B32 ]]; then
	skip_test "bash32 warning" "no bash 3.x present"
else
	warn_out=$(env HOME="$HOME_DIR" PATH="$PATH_BASE" "$B32" "$REPO_ROOT/bin/rm-safe.bash" --about 2>&1 >/dev/null)
	quiet_out=$(env HOME="$HOME_DIR" PATH="$PATH_BASE" RM_SAFE_QUIET=1 "$B32" "$REPO_ROOT/bin/rm-safe.bash" --about 2>&1 >/dev/null)
	if printf '%s' "$warn_out" | grep -qi "running under bash" && ! printf '%s' "$quiet_out" | grep -qi "running under bash"; then
		echo "OK bash 3.2 warning emitted and suppressible"
	else
		echo "FAIL bash 3.2 warning behavior wrong" >&2
		((fails++))
	fi
fi

# Test: bash impl prefers a g-prefixed tool when available
((tests++))
gshim="$TEST_DIR/gshim"; mkdir -p "$gshim"
cat >"$gshim/gmktemp" <<EOF
#!/bin/sh
echo "GMKTEMP_USED" >>"$TEST_DIR/gmktemp.trace"
exec mktemp "\$@"
EOF
chmod +x "$gshim/gmktemp"
env HOME="$HOME_DIR" PATH="$gshim:$PATH_BASE" "$REPO_ROOT/bin/rm-safe.bash" --test >/dev/null 2>&1 || true
if [[ -f "$TEST_DIR/gmktemp.trace" ]]; then
	echo "OK bash impl used g-prefixed gmktemp when present"
else
	echo "FAIL g-prefixed tool not preferred" >&2
	((fails++))
fi

# Test: undo survives a missing `printable-binary`.
# Regression guard. The fragment filename is built from pb_encode(original_path),
# which shells out to printable-binary to make the path filesystem-safe (/ -> ⁄).
# When that tool was absent the fallback returned the path UNCHANGED, so the
# fragment name still contained slashes, the write landed in a nonexistent
# directory and failed silently -- the file was trashed but no log fragment
# existed, so --undo could never restore it. printable-binary is not a
# documented dependency, so this was the default experience for most installs.
reset_trash
((tests++))
echo "nopb-payload" >"$WORK_DIR/nopb.txt"
NOPB_HOST_PATH=$(path_without_commands "$HOST_PATH" printable-binary)
NOPB_PATH="$BIN_DIR:$BASH_DIR:$REPO_ROOT/bin:$NOPB_HOST_PATH"
if env PATH="$NOPB_PATH" command -v printable-binary >/dev/null 2>&1; then
	skip_test "missing printable-binary" "could not construct a PATH without printable-binary"
else
	run_cmd_with_path "$NOPB_PATH" "$WORK_DIR/nopb.txt"
	nopb_rc=$RM_RC
	nopb_line=$(read_all_logs | awk -F'\t' '$3=="TRASH_MANUAL"{line=$0} END{print line}')
	run_cmd_with_path "$NOPB_PATH" --undo
	if [[ $nopb_rc -eq 0 && -n $nopb_line && -f "$WORK_DIR/nopb.txt" \
		&& $(cat "$WORK_DIR/nopb.txt") == "nopb-payload" ]]; then
		echo "OK undo works without printable-binary installed"
	else
		echo "FAIL undo broken without printable-binary (trash rc=$nopb_rc, log entry: ${nopb_line:-<none>})" >&2
		((fails++))
	fi
fi

echo "=== Test Summary ==="
echo "Passed: $((tests - fails - skips))"
echo "Skipped: $skips" >&2
echo "Failed: $fails" >&2
exit $fails
